# ── Single account (backward-compatible) ──
TG_API_ID=123456
TG_API_HASH=your_api_hash_here
TG_PHONE_NUMBER=+1234567890

# ── Multi-account (JSON array) ──
# Set this to use multiple accounts instead of the single one above.
# Each account can have its own phone, api_id, api_hash, label, proxy, session_path.
# TG_ACCOUNTS_JSON='[
#   {"phone_number":"+1111111111","api_id":123,"api_hash":"xxx","label":"acc1","proxy":"socks5://user:pass@host:1080"},
#   {"phone_number":"+2222222222","api_id":456,"api_hash":"yyy","label":"acc2","proxy":""}
# ]'

# ── Default proxy for all accounts ──
# TG_DEFAULT_PROXY=socks5://user:pass@127.0.0.1:1080

# ── Sessions & data ──
TG_SESSION_DIR=data/sessions
TG_SQLITE_PATH=data/state.db

# ── Campaign storage ──
TG_CAMPAIGNS_DIR=data/campaigns
TG_GROUP_LISTS_DIR=data/group_lists

# ── Rate limiting ──
TG_SEND_INTERVAL_SECONDS=8
TG_LOOP_INTERVAL_SECONDS=120
TG_JITTER_MIN_SECONDS=0.5
TG_JITTER_MAX_SECONDS=2
TG_MAX_MESSAGES_PER_HOUR=40
TG_MAX_MESSAGES_PER_DAY=50

# ── Smart pacing (UTC hours) ──
TG_ACTIVE_HOURS_START=8
TG_ACTIVE_HOURS_END=23

# ── Group lifecycle ──
TG_AUTO_LEAVE_AFTER_SEND=false
TG_JOIN_WARMUP_SECONDS=60
